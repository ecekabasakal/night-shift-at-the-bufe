# Unity .gitignore for Night Shift at the Büfe
# Note: .meta files under Assets/ and Packages/ must stay tracked.

# Unity generated folders (project root only)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Bb]uild/
/[Bb]uilds/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Build archives made for itch.io
*.zip

# Batchmode output (logs and test results)
*.log
/TestResults*.xml

# Never ignore Asset meta data
!/[Aa]ssets/**/*.meta

# Autogenerated Visual Studio / Rider / VS Code project files
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.unityproj
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
/.vs/
/.vscode/
/.idea/
/.gradle/
/ExportedObj/
/.consulo/

# Unity generated meta files for debug data
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports and dumps
sysinfo.txt
mono_crash.*
*.dmp
*.stackdump

# Builds and packages
*.apk
*.aab
*.unitypackage
*.app

# Addressables / plugin caches
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS files
.DS_Store
Thumbs.db
